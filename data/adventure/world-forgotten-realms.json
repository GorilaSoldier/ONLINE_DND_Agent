{
  "id": "forgotten-realms",
  "name": "被遗忘的国度",
  "start_location": "sword-coast",
  "locations": {
    "sword-coast": {
      "id": "sword-coast",
      "name": "剑湾北部",
      "type": "world",
      "parent": null,
      "neighbors": { "up": null, "down": "triboar-trail", "left": null, "right": null },
      "scene_text": "剑湾北部的广袤大地上，凡达林镇坐落在三猪小径旁。绝冬森林的阴影笼罩着北方，古老的矮人遗迹散落其间。",
      "npcs": []
    },
    "triboar-trail": {
      "id": "triboar-trail",
      "name": "三猪小径",
      "type": "wild",
      "parent": "sword-coast",
      "neighbors": { "up": "sword-coast", "down": "phandalin", "left": "old-owl-well", "right": "wyvern-tor" },
      "scene_text": "三猪小径蜿蜒穿过剑山山麓，连接着绝冬城与凡达林。路旁散落着被遗弃的马车残骸，提醒着旅人此路并非太平。",
      "npcs": []
    },
    "old-owl-well": {
      "id": "old-owl-well",
      "name": "古枭井",
      "type": "wild",
      "parent": "triboar-trail",
      "neighbors": { "up": null, "down": null, "left": null, "right": "triboar-trail" },
      "scene_text": "一座破败的古老瞭望塔矗立在山丘之上。塔的周围，十二个僵尸以诡异的阵型伫立不动——一个红袍法师在此地进行着不可告人的研究。",
      "npcs": ["kost"]
    },
    "wyvern-tor": {
      "id": "wyvern-tor",
      "name": "飞龙岩",
      "type": "wild",
      "parent": "triboar-trail",
      "neighbors": { "up": null, "down": null, "left": "triboar-trail", "right": null },
      "scene_text": "一个巨大的天然岩洞隐藏在山丘之中。兽人强盗以此为据点，劫掠过往的商旅。洞中传来粗野的咆哮声。",
      "npcs": []
    },
    "phandalin": {
      "id": "phandalin",
      "name": "凡达林镇",
      "type": "town",
      "parent": "triboar-trail",
      "neighbors": { "up": "triboar-trail", "down": "phandalin-main-street", "left": null, "right": null },
      "scene_text": "凡达林，一座正在复苏的边境小镇。木结构建筑沿主街排列，矿工和商贩让这里充满生机。但空气中弥散着不安——红标帮的阴影尚未完全散去。",
      "npcs": ["harbin-wester"]
    },
    "phandalin-main-street": {
      "id": "phandalin-main-street",
      "name": "主街",
      "type": "street",
      "parent": "phandalin",
      "neighbors": {
        "up": "phandalin",
        "down": "phandalin-south-gate",
        "left": "stonehill-inn",
        "right": "barthens-provisions"
      },
      "scene_text": "主街两旁排列着木结构建筑，来往的矿工和商贩让这里成为小镇最热闹的地方。脚下的石板路被岁月磨得光滑。",
      "npcs": []
    },
    "phandalin-south-gate": {
      "id": "phandalin-south-gate",
      "name": "南门",
      "type": "street",
      "parent": "phandalin",
      "neighbors": {
        "up": "phandalin-main-street",
        "down": null,
        "left": "edermath-orchard",
        "right": "alderleaf-farm"
      },
      "scene_text": "小镇南门简陋的木栅栏敞开着。从这里可以望见远处的农场和果园，以及通往南方的土路。",
      "npcs": []
    },
    "stonehill-inn": {
      "id": "stonehill-inn",
      "name": "石丘旅馆",
      "type": "building",
      "parent": "phandalin-main-street",
      "neighbors": { "up": "stonehill-inn-hall", "down": "phandalin-main-street", "left": null, "right": null },
      "scene_text": "石丘旅馆是凡达林最大的建筑之一，一楼的窗户透出温暖的橙色灯光。招牌上画着一块巨石上方冒着炊烟。",
      "npcs": [],
      "rooms": {
        "stonehill-inn-hall": {
          "id": "stonehill-inn-hall",
          "name": "旅馆大厅",
          "type": "room",
          "parent": "stonehill-inn",
          "neighbors": { "up": null, "down": "stonehill-inn-kitchen", "left": null, "right": null },
          "scene_text": "大厅里壁炉噼啪作响，麦酒的香气弥漫在空气中。托布拉·石丘正在吧台后擦拭酒杯，角落里几个矿工在低声交谈。",
          "npcs": ["toblen-stonehill", "freda-miner"]
        },
        "stonehill-inn-kitchen": {
          "id": "stonehill-inn-kitchen",
          "name": "厨房",
          "type": "room",
          "parent": "stonehill-inn",
          "neighbors": { "up": "stonehill-inn-hall", "down": null, "left": null, "right": null },
          "scene_text": "厨房里弥漫着炖肉的香气，切菜板上堆着刚切好的蔬菜。锅里的浓汤咕嘟作响。",
          "npcs": ["pip-stonehill"]
        }
      }
    },
    "barthens-provisions": {
      "id": "barthens-provisions",
      "name": "巴森工坊",
      "type": "building",
      "parent": "phandalin-main-street",
      "neighbors": { "up": null, "down": null, "left": "phandalin-main-street", "right": null },
      "scene_text": "巴森工坊是凡达林最大的贸易商站，货架上堆满了采矿工具、绳索和日用品。巴森·普罗维恩斯正忙着清点货物。",
      "npcs": ["barthen"]
    },
    "lionshield-coster": {
      "id": "lionshield-coster",
      "name": "狮盾补给站",
      "type": "building",
      "parent": "phandalin-main-street",
      "neighbors": { "up": null, "down": null, "left": null, "right": "phandalin-main-street" },
      "scene_text": "狮盾补给站是镇上唯一的武器和防具商店。墙上挂着各式剑盾，柜台上摆着一副刚打磨好的胸甲。",
      "npcs": ["linene-graywind"]
    },
    "edermath-orchard": {
      "id": "edermath-orchard",
      "name": "艾德玛斯果园",
      "type": "building",
      "parent": "phandalin-south-gate",
      "neighbors": { "up": null, "down": null, "left": null, "right": "phandalin-south-gate" },
      "scene_text": "半精灵达兰·艾德玛斯的果园宁静安详。苹果树整齐排列，树下一把旧椅子上放着一本翻开的冒险日志。",
      "npcs": ["daran-edermath"]
    },
    "alderleaf-farm": {
      "id": "alderleaf-farm",
      "name": "艾德利夫农场",
      "type": "building",
      "parent": "phandalin-south-gate",
      "neighbors": { "up": null, "down": null, "left": "phandalin-south-gate", "right": null },
      "scene_text": "半身人奎琳·艾德利夫的农场里，南瓜藤爬满了篱笆。一个小男孩正蹲在草丛里，似乎在观察什么东西。",
      "npcs": ["qelline-alderleaf", "carp-alderleaf"]
    },
    "redbrand-hideout": {
      "id": "redbrand-hideout",
      "name": "红标帮窝点",
      "type": "building",
      "parent": "phandalin",
      "neighbors": { "up": null, "down": null, "left": "phandalin", "right": null },
      "scene_text": "这座原本的小镇大厅已被红标帮占据。破旧的建筑外表下隐藏着地下密室——据说密室里关押着无辜的镇民。",
      "npcs": ["glasstaff"]
    },
    "phal-shrine-of-luck": {
      "id": "phal-shrine-of-luck",
      "name": "幸运神殿",
      "type": "building",
      "parent": "phandalin-main-street",
      "neighbors": { "up": "phandalin-main-street", "down": null, "left": null, "right": null },
      "scene_text": "一座朴素的小神殿，供奉着幸运女神提摩拉。烛光摇曳中，加莉尔修女正在低声祈祷。",
      "npcs": ["sister-garaele"]
    },
    "neverwinter-woods": {
      "id": "neverwinter-woods",
      "name": "绝冬森林",
      "type": "wild",
      "parent": "sword-coast",
      "neighbors": { "up": null, "down": "sword-coast", "left": "cragmaw-castle", "right": "thundertree" },
      "scene_text": "绝冬森林幽深茂密，参天古树的枝叶遮蔽了阳光。林间小径上覆盖着厚厚的落叶，偶尔传来不知名野兽的低吼。",
      "npcs": []
    },
    "cragmaw-castle": {
      "id": "cragmaw-castle",
      "name": "克拉摩堡",
      "type": "wild",
      "parent": "neverwinter-woods",
      "neighbors": { "up": null, "down": null, "left": null, "right": "neverwinter-woods" },
      "scene_text": "一座被遗弃的古老矮人城堡，如今被克拉摩地精部落占据。城墙上残破的垛口后，隐约可以看到弓箭手的影子。",
      "npcs": []
    },
    "thundertree": {
      "id": "thundertree",
      "name": "雷树废墟",
      "type": "wild",
      "parent": "neverwinter-woods",
      "neighbors": { "up": null, "down": null, "left": "neverwinter-woods", "right": null },
      "scene_text": "雷树曾是一座繁荣的伐木村庄，如今只剩下断壁残垣。空气中弥漫着硫磺味，植被异常地疯长——据说一条绿龙在此筑了巢。",
      "npcs": ["reidoth"]
    }
  }
}
