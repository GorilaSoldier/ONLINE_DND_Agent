      "abilities": {
        "str": 17,
        "dex": 8
      },
      "attitude": "hostile",
      "current_location": "cragmaw-hideout-boss",
      "reactions": {
        "combat": {
          "opening": "“又是来送死的？”克拉格咆哮着站起身，举起他那根沉重的木棍。",
          "low_hp": "他发出愤怒的嚎叫，试图撤退到高台上。"
        },
        "intimidated": {
          "success": "克拉格的眼神闪烁了一下，但他很快镇定下来。",
          "failure": "他大笑起来，露出参差不齐的尖牙。"
        }
      },
      "items": ["gundrens-map", "klargs-coinpurse"]
    },
